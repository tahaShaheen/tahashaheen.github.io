---
layout: default
---
<!-- page.html -->
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
    {% if page.button %}
      <div class="mb-3">
        <a href="{{ page.button.url }}" class="btn btn-sm z-depth-0 w-100 fw-bold" role="button" target="_blank" style="background-color: var(--global-theme-color); color: white; border-color: var(--global-theme-color);">{{ page.button.text }}</a>
      </div>
    {% endif %}
    {% if page.buttons %}
      {% for button in page.buttons %}
        <div class="mb-3">
          <a href="{{ button.url }}" class="btn btn-sm z-depth-0 w-100 fw-bold" role="button" target="_blank" style="background-color: var(--global-theme-color); color: white; border-color: var(--global-theme-color);">{{ button.text }}</a>
        </div>
      {% endfor %}
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
