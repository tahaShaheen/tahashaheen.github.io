---
layout: default
---
<!-- page.html -->
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
    {% if page.button or page.buttons %}
      <div class="page-top-actions">
        {% if page.button %}
          <a href="{{ page.button.url }}" class="page-top-action" role="button" target="_blank">
            {% assign button_icon = page.button.icon %}
            {% unless button_icon %}
              {% assign button_text = page.button.text | downcase %}
              {% if button_text contains 'paper' %}
                {% assign button_icon = 'fa-regular fa-file-lines' %}
              {% elsif button_text contains 'poster' %}
                {% assign button_icon = 'fa-regular fa-image' %}
              {% elsif button_text contains 'presentation' %}
                {% assign button_icon = 'fa-solid fa-display' %}
              {% elsif button_text contains 'game' %}
                {% assign button_icon = 'fa-solid fa-gamepad' %}
              {% elsif button_text contains 'code' or button_text contains 'data' %}
                {% assign button_icon = 'fa-solid fa-code' %}
              {% endif %}
            {% endunless %}
            {% if button_icon %}
              <i class="{{ button_icon }} page-top-action-icon" aria-hidden="true"></i>
            {% endif %}
            <span class="page-top-action-text">{{ page.button.text }}</span>
          </a>
        {% endif %}
        {% for button in page.buttons %}
          <a href="{{ button.url }}" class="page-top-action" role="button" target="_blank">
            {% assign button_icon = button.icon %}
            {% unless button_icon %}
              {% assign button_text = button.text | downcase %}
              {% if button_text contains 'paper' %}
                {% assign button_icon = 'fa-regular fa-file-lines' %}
              {% elsif button_text contains 'poster' %}
                {% assign button_icon = 'fa-regular fa-image' %}
              {% elsif button_text contains 'presentation' %}
                {% assign button_icon = 'fa-solid fa-display' %}
              {% elsif button_text contains 'game' %}
                {% assign button_icon = 'fa-solid fa-gamepad' %}
              {% elsif button_text contains 'code' or button_text contains 'data' %}
                {% assign button_icon = 'fa-solid fa-code' %}
              {% endif %}
            {% endunless %}
            {% if button_icon %}
              <i class="{{ button_icon }} page-top-action-icon" aria-hidden="true"></i>
            {% endif %}
            <span class="page-top-action-text">{{ button.text }}</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
