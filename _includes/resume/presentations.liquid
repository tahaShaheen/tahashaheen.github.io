<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign presentations = data[1] | sort: 'startDate' | reverse %}
  {% for content in presentations %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-3 text-center" style="width: 75px">
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
            {% include format-date-range.liquid startDate=content.startDate %}
          </span>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-9 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            <a href="{{ content.url }}">{{ content.name }}</a>
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.location }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.summary }}</h6>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>